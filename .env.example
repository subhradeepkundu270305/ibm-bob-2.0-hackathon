# ─── URL Shortener — Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in values for your local environment.
# .env is git-ignored and bob-ignored; .env.example is safe to commit.

# TCP port the Express server listens on.
# Default: 5000
PORT=5000

# Base URL prepended to every generated short link.
# Override when running behind a reverse proxy or a custom domain.
# Default: http://localhost:<PORT>
BASE_URL=http://localhost:5000

# Path to the SQLite database file, relative to the project root.
# Use :memory: to run entirely in-memory (used by the test suite automatically).
# Default: database.sqlite
DB_PATH=database.sqlite
